# PT-Gen API 测试文件
# 注意: apiKey, baseUrl 从 http-client.env.json 读取，运行时选择 dev 环境

### ========================================
### 图片代理接口
### ========================================

### 代理豆瓣图片（解决防盗链）
GET {{baseUrl}}/img?url=https://img9.doubanio.com/view/photo/l/public/p2929427346.webp&key={{apiKey}}

<> response/2026-05-12T105319.200.webp

### ========================================
### 豆瓣 (Douban)
### ========================================

### --- URL 方式 ---

### GET - 豆瓣电影（流浪地球2: 35267208）
GET {{baseUrl}}/api?url=https://movie.douban.com/subject/35267208/&key={{apiKey}}

<> response/2026-05-12T105551.200.json

### POST - 豆瓣电影
POST {{baseUrl}}/api?key={{apiKey}}
Content-Type: application/json

{
  "url": "https://movie.douban.com/subject/35267208/"
}

<> response/2026-05-12T105719.200.json

### GET - 豆瓣读书（翠鸟谋杀案: 38229491）
GET {{baseUrl}}/api?url=https://book.douban.com/subject/38229491/&key={{apiKey}}

<> response/2026-05-12T105808.200.json

### --- Params 方式 ---

### GET - 豆瓣电影
GET {{baseUrl}}/api?source=douban&sid=35267208&key={{apiKey}}

<> response/2026-05-12T112333.200.json

### POST - 豆瓣电影
POST {{baseUrl}}/api?key={{apiKey}}
Content-Type: application/json

{
  "source": "douban",
  "sid": "35267208"
}

<> response/2026-05-12T112408.200.json

### --- 搜索 ---

### 指定来源搜索 - 豆瓣
GET {{baseUrl}}/api?source=douban&query=流浪地球&key={{apiKey}}

<> response/2026-05-12T122308.200.json

### POST - 指定来源搜索豆瓣
POST {{baseUrl}}/api?key={{apiKey}}
Content-Type: application/json

{
  "source": "douban",
  "query": "流浪地球"
}

<> response/2026-05-12T122438.200.json

### ========================================
### IMDb
### ========================================

### --- URL 方式 ---

### GET - IMDb 电影（魔力麦克: tt1915581）
GET {{baseUrl}}/api?url=https://www.imdb.com/title/tt1915581/&key={{apiKey}}

<> response/2026-05-12T110005.200.json

### POST - IMDb 电影
POST {{baseUrl}}/api?key={{apiKey}}
Content-Type: application/json

{
  "url": "https://www.imdb.com/title/tt1915581/"
}

<> response/2026-05-12T110401.200.json

### --- Params 方式 ---

### GET - IMDb 电影
GET {{baseUrl}}/api?source=imdb&sid=tt1915581&key={{apiKey}}

<> response/2026-05-12T112506.200.json

### --- 搜索 ---
# 注意: IMDb 搜索可能触发 WAF 保护，建议配置 TMDB_API_KEY 作为回退

### 指定来源搜索 - IMDb
GET {{baseUrl}}/api?source=imdb&query=Independence Day&key={{apiKey}}

### ========================================
### TMDB (The Movie Database)
### 注意: TMDB 必须提供 type 参数 (movie 或 tv)
### ========================================

### --- URL 方式 ---

### GET - TMDB 电影（心的居所: 191）
GET {{baseUrl}}/api?url=https://www.themoviedb.org/movie/191&key={{apiKey}}

<> response/2026-05-12T111438.200.json

### GET - TMDB 电视剧（绝命毒师: 1396）
GET {{baseUrl}}/api?url=https://www.themoviedb.org/tv/1396&key={{apiKey}}

<> response/2026-05-12T111911.200.json

### --- Params 方式 ---

### GET - TMDB 电影
GET {{baseUrl}}/api?source=tmdb&sid=191&type=movie&key={{apiKey}}

<> response/2026-05-12T121147.200.json

### GET - TMDB 电视剧
GET {{baseUrl}}/api?source=tmdb&sid=1396&type=tv&key={{apiKey}}

<> response/2026-05-12T121239.200.json

### POST - TMDB 电影
POST {{baseUrl}}/api?key={{apiKey}}
Content-Type: application/json

{
  "source": "tmdb",
  "sid": "191",
  "type": "movie"
}

<> response/2026-05-12T121333.200.json

### --- 搜索 ---

### 指定来源搜索 - TMDB
GET {{baseUrl}}/api?source=tmdb&query=流浪地球&key={{apiKey}}

<> response/2026-05-12T122339.200.json

